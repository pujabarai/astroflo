# AstroFlo frontend — public testnet configuration.
# Copy to .env.local to run: cp .env.example .env.local
# All contract addresses are public Stellar testnet identifiers.

NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed contracts (XLM/USDC 0.3% pool)
NEXT_PUBLIC_FACTORY_ADDRESS=CDFY5UX77PQDP2QGNY4YGZVKK6FE6J2LSSVZFXTQSHRO2JIES7LSZGPE
